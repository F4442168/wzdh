const JSON_HEADERS = {
  "Content-Type": "application/json; charset=utf-8",
  "Cache-Control": "no-store",
  "X-Content-Type-Options": "nosniff"
};
const json = (data, status = 200) => new Response(JSON.stringify(data), { status, headers: JSON_HEADERS });

async function getConfig(env) {
  const raw = await env.NAV_DB.get("site_config");
  let c = {};
  if (raw) { try { c = JSON.parse(raw) || {}; } catch (_) {} }
  if (!Array.isArray(c.dynamicSections)) c.dynamicSections = [];
  if (typeof c.wallpaper !== "string") c.wallpaper = "";
  return c;
}
function passwordFor(env, config) { return config.adminPwd || env.ADMIN_PASSWORD || "admin888"; }
async function isAdmin(request, env, config) {
  const token = request.headers.get("X-Admin-Token") || "";
  return !!token && token === passwordFor(env, config);
}

export default {
  async fetch(request, env) {
    const { pathname } = new URL(request.url);
    if (request.method === "GET" && (pathname === "/" || pathname === "/index.html")) {
      return new Response(HTML, { headers: { "Content-Type": "text/html; charset=utf-8", "X-Content-Type-Options": "nosniff", "Referrer-Policy": "strict-origin-when-cross-origin" } });
    }
    if (!env.NAV_DB) return json({ success: false, error: "请先绑定 NAV_DB KV Namespace" }, 500);

    if (pathname === "/api/login" && request.method === "POST") {
      try {
        const body = await request.json();
        const config = await getConfig(env);
        if (typeof body.password !== "string" || body.password !== passwordFor(env, config)) return json({ success: false }, 401);
        return json({ success: true, token: body.password });
      } catch (_) { return json({ success: false, error: "请求格式错误" }, 400); }
    }

    if (pathname === "/api/config" && request.method === "GET") {
      const config = await getConfig(env);
      delete config.adminPwd;
      return json(config);
    }

    if (pathname === "/api/config" && request.method === "POST") {
      const config = await getConfig(env);
      if (!(await isAdmin(request, env, config))) return json({ success: false, error: "未授权" }, 401);
      try {
        const body = await request.json();
        config.wallpaper = typeof body.wallpaper === "string" ? body.wallpaper : config.wallpaper;
        config.dynamicSections = Array.isArray(body.dynamicSections) ? body.dynamicSections : config.dynamicSections;
        await env.NAV_DB.put("site_config", JSON.stringify(config));
        return json({ success: true });
      } catch (_) { return json({ success: false, error: "JSON 数据无效" }, 400); }
    }

    if (pathname === "/api/password" && request.method === "POST") {
      const config = await getConfig(env);
      if (!(await isAdmin(request, env, config))) return json({ success: false, error: "未授权" }, 401);
      try {
        const body = await request.json();
        if (typeof body.newPassword !== "string" || body.newPassword.trim().length < 8) return json({ success: false, error: "新密码至少需要 8 位" }, 400);
        config.adminPwd = body.newPassword.trim();
        await env.NAV_DB.put("site_config", JSON.stringify(config));
        return json({ success: true, token: config.adminPwd });
      } catch (_) { return json({ success: false, error: "JSON 数据无效" }, 400); }
    }

    if (pathname === "/api/links" && request.method === "GET") {
      return new Response((await env.NAV_DB.get("custom_links")) || "[]", { headers: JSON_HEADERS });
    }
    if (pathname === "/api/links" && request.method === "POST") {
      const config = await getConfig(env);
      if (!(await isAdmin(request, env, config))) return json({ success: false, error: "未授权" }, 401);
      try {
        const body = await request.text(); JSON.parse(body);
        await env.NAV_DB.put("custom_links", body);
        return json({ success: true, message: "保存成功" });
      } catch (_) { return json({ success: false, error: "JSON 数据无效" }, 400); }
    }
    return new Response("Not Found", { status: 404 });
  }
};
