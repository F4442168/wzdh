utton type=\"button\" onclick=\"toggleModal(false)\" class=\"px-4 py-2 bg-slate-800 text-slate-400 text-xs font-medium rounded-xl hover:bg-slate-700 transition-colors cursor-pointer\" data-i18n=\"btnCancel\">取消</button>\n                <button type=\"button\" onclick=\"saveActiveLink()\" class=\"px-4 py-2 bg-indigo-600 text-white text-xs font-medium rounded-xl hover:bg-indigo-500 transition-colors cursor-pointer shadow-lg shadow-indigo-600/20\" data-i18n=\"btnSave\">保存站点</button>\n            </div>\n        </div>\n    </div>\n\n    <script>\n        // --- 0. 全局状态与配置 ---\n        let currentLang = localStorage.getItem('nav_lang') || 'zh';\n        let expandedDynamicSections = {};\n        let currentModalTarget = '';\n        let currentEngineKey = 'google';\n\n        // 全局云端配置中心：整合了壁纸、分类区域 和 管理员密码\n        let cloudConfig = { wallpaper: \"\", dynamicSections: [], adminPwd: \"\" };\n\n        let dragType = null;\n        let dragSecId = null;\n        let dragLinkIdx = null;\n\n        // 区域每行显示列数的默认值范围\n        const MIN_COLS = 1;\n        const MAX_COLS = 6;\n        const DEFAULT_COLS = 2;\n\n        // 默认管理员口令（用于首次写入前，云端尚未保存过密码时的兜底）\n        const DEFAULT_ADMIN_PWD = \"admin888\";\n\n        // 获取当前应当使用的鉴权口令\n        function getAdminToken() {\n            return localStorage.getItem('nav_admin_token') || '';\n        }\n\n        // 统一的后端写请求方法，自动附带鉴权头\n        async function postCloudConfig() {\n            const res = await fetch('/api/config', {\n                method: 'POST',\n                headers: {\n                    'Content-Type': 'application/json',\n                    'X-Admin-Token': getAdminToken()\n                },\n                body: JSON.stringify(cloudConfig)\n            });\n            if (!res.ok) {\n                let msg = '保存失败';\n                try {\n                    const data = await res.json();\n                    if (data && data.error) msg = data.error;\n                } catch (_) {}\n                throw new Error(msg);\n            }\n            return res.json().catch(() => ({}));\n        }\n\n        const i18n = {\n            zh: {\n                pageTitle: \"网址导航\", themeBtn: \"个性化\", langTitle: \"语言 / Language\", themeTitle: \"基础色彩模式 (本地偏好)\",\n                themeLight: \"日间\", themeDark: \"夜间\", bgTitle: \"自定义背景 (全站同步)\", bgInputPlace: \"输入图片网址 https://...\",\n                applyBtn: \"应用\", clearBg: \"清除壁纸\", logoutBtn: \"退出后台管理\",\n                enGoogle: \"谷歌 Google\", enBing: \"必应 Bing\", enBaidu: \"百度 Baidu\", searchGoogle: \"在 Google 中搜索...\", searchBing: \"在 必应 Bing 中搜索...\", searchBaidu: \"在 百度 Baidu 中搜索...\", searchGithub: \"在 GitHub 中搜索仓库...\",\n                addCloud: \"添加 (链接)\", expandMore: \"展开显示更多\", collapseMore: \"收起部分站点\",\n                footerText: \"登录入口\", adminBadge: \"已登入\",\n                siteName: \"网站名称\", siteNamePlace: \"例如：百度\", siteUrl: \"网站网址 (URL)\",\n                btnCancel: \"取消\", btnSave: \"保存站点\", noCloudLinks: \"暂无自定义链接\",\n                pwdPrompt: \"🔐 请输入后台管理员安全密码：\", pwdSuccess: \"🎉 认证成功！管理功能已全部解锁。\", pwdFail: \"❌ 密码错误，鉴权失败！\", logoutMsg: \"🔒 已安全退出管理后台，页面回归只读状态。\",\n                validUrlMsg: \"提示：请输入有效的网址！\",\n                addSectionBtn: \"添加自定义区域\", promptSectionName: \"请输入新区域的名称 (例如：AI工具)：\", delSectionConfirm: \"确定要删除整个区域及其所有链接吗？\", modalAddSection: \"添加到自定义区域\",\n                renameSectionPrompt: \"请输入新的区域名称：\",\n                promptSectionCols: \"请设置该区域每行显示的链接数量 (1-6，默认 2)：\",\n                changeColsTitle: \"调整每行显示数量\",\n                colsInvalidMsg: \"输入无效，已使用默认值 2。请输入 1-6 之间的数字。\",\n                pwdTitle: \"修改管理员密码 (全站同步)\", pwdInputPlace: \"输入新密码\", saveBtn: \"保存\", pwdUpdateSuccess: \"管理员密码修改成功！下次登录生效。\",\n                saveFailMsg: \"保存到云端失败：\"\n            },\n            en: {\n                pageTitle: \"Website Directory\", themeBtn: \"Customize\", langTitle: \"Language / 语言\", themeTitle: \"Color Theme (Local Pref)\",\n                themeLight: \"Light\", themeDark: \"Dark\", bgTitle: \"Custom Wallpaper (Cloud Sync)\", bgInputPlace: \"Image URL https://...\",\n                applyBtn: \"Apply\", clearBg: \"Clear Wallpaper\", logoutBtn: \"Logout Admin\",\n                enGoogle: \"Google\", enBing: \"Bing\", enBaidu: \"Baidu\", searchGoogle: \"Search in Google...\", searchBing: \"Search in Bing...\", searchBaidu: \"Search in Baidu...\", searchGithub: \"Search in GitHub...\",\n                addCloud: \"Add (Link)\", expandMore: \"Show More\", collapseMore: \"Collapse\",\n                footerText: \"Login Portal\", adminBadge: \"Logged In\",\n                siteName: \"Site Name\", siteNamePlace: \"e.g., Google\", siteUrl: \"Site URL\",\n                btnCancel: \"Cancel\", btnSave: \"Save Site\", noCloudLinks: \"No custom links yet\",\n                pwdPrompt: \"🔐 Enter Admin Password:\", pwdSuccess: \"🎉 Authenticated! Admin features unlocked.\", pwdFail: \"❌ Incorrect password!\", logoutMsg: \"🔒 Logged out safely. Read-only mode activated.\",\n                validUrlMsg: \"Please enter a valid URL!\",\n                addSectionBtn: \"Add Custom Section\", promptSectionName: \"Enter new section name (e.g., AI Tools):\", delSectionConfirm: \"Are you sure you want to delete this entire section?\", modalAddSection: \"Add to Custom Section\",\n                renameSectionPrompt: \"Enter new section name:\",\n                promptSectionCols: \"Set links per row for this section (1-6, default 2):\",\n                changeColsTitle: \"Change columns per row\",\n                colsInvalidMsg: \"Invalid input, using default 2. Please enter a number between 1-6.\",\n                pwdTitle: \"Change Admin Password (Cloud Sync)\", pwdInputPlace: \"Enter new password\", saveBtn: \"Save\", pwdUpdateSuccess: \"Admin password updated successfully! Valid on next login.\",\n                saveFailMsg: \"Failed to save to cloud: \"\n            }\n        };\n\n        function escapeHtml(value) {\n            return String(value ?? '').replace(/[&<>\"']/g, ch => ({\n                '&': '&', '<': '<', '>': '>', '\"': '\"', \"'\": '&#39;'\n            }[ch]));\n        }\n        function safeHttpUrl(value) {\n            try {\n                const u = new URL(String(value ?? ''), window.location.href);\n                return (u.protocol === 'http:' || u.protocol === 'https:') ? u.href : '#';\n            } catch (_) { return '#'; }\n        }\n        function t(key) { return i18n[currentLang][key] || key; }\n        function setLanguage(lang) {\n            currentLang = lang; localStorage.setItem('nav_lang', lang); document.documentElement.lang = lang === 'zh' ? 'zh-CN' : 'en';\n            applyLanguage(); updateClockAndGreeting(); selectEngine(currentEngineKey); document.getElementById('theme-panel').classList.add('hidden');\n        }\n        function applyLanguage() {\n            document.getElementById('page-title').innerText = t('pageTitle');\n            document.querySelectorAll('[data-i18n]').forEach(el => { el.innerHTML = t(el.getAttribute('data-i18n')); });\n            document.querySelectorAll('[data-i18n-placeholder]').forEach(el => { el.placeholder = t(el.getAttribute('data-i18n-placeholder')); });\n            renderDynamicSections();\n        }\n\n        // --- 1. 管理员鉴权 (动态密码校验) ---\n        function checkAdminSession() {\n            const isAdmin = localStorage.getItem('nav_admin_auth') === 'true';\n            if (isAdmin) { document.body.classList.add('is-admin'); document.getElementById('admin-badge').classList.remove('hidden'); }\n            else { document.body.classList.remove('is-admin'); document.getElementById('admin-badge').classList.add('hidden'); }\n        }\n\n        async function triggerAdminLogin() {\n            if (localStorage.getItem('nav_admin_auth') === 'true') { alert(currentLang === 'zh' ? \"提示：您已处于后台管理模式。\" : \"Notice: You are already in admin mode.\"); return; }\n            const pwd = prompt(t('pwdPrompt'));\n            if (pwd === null) return;\n            try {\n                const res = await fetch('/api/login', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ password: pwd }) });\n                const data = await res.json();\n                if (res.ok && data.success) {\n                    localStorage.setItem('nav_admin_token', data.token);\n                    localStorage.setItem('nav_admin_auth', 'true');\n                    alert(t('pwdSuccess')); checkAdminSession();\n                } else alert(t('pwdFail'));\n            } catch (_) { alert(currentLang === 'zh' ? '登录请求失败，请稍后重试。' : 'Login request failed. Please try again.'); }\n        }\n\n        function logoutAdmin() {\n            localStorage.removeItem('nav_admin_auth'); localStorage.removeItem('nav_admin_token'); alert(t('logoutMsg'));\n            expandedDynamicSections = {}; checkAdminSession(); document.getElementById('theme-panel').classList.add('hidden');\n        }\n\n        // 修改并同步管理员密码：使用旧密码鉴权，写入新密码\n        async function updateAdminPwd() {\n            const newPwd = document.getElementById('custom-pwd-input').value.trim();\n            if (!newPwd) return;\n            if (newPwd.length < 8) return alert(currentLang === 'zh' ? '新密码至少需要 8 位。' : 'Password must be at least 8 characters.');\n            try {\n                const res = await fetch('/api/password', {\n                    method: 'POST',\n                    headers: { 'Content-Type': 'application/json', 'X-Admin-Token': getAdminToken() },\n                    body: JSON.stringify({ newPassword: newPwd })\n                });\n                const data = await res.json().catch(() => ({}));\n                if (!res.ok || !data.success) throw new Error(data.error || '保存失败');\n                localStorage.setItem('nav_admin_token', data.token || newPwd);\n                document.getElementById('custom-pwd-input').value = '';\n                document.getElementById('theme-panel').classList.add('hidden');\n                alert(t('pwdUpdateSuccess'));\n            } catch (e) { alert(t('saveFailMsg') + e.message); }\n        }\n\n        // --- 2. 拖拽核心控制逻辑 ---\n        function handleDragStart(e, type, secId, linkIdx = null) {\n            e.stopPropagation();\n            if (localStorage.getItem('nav_admin_auth') !== 'true') { e.preventDefault(); return; }\n            dragType = type; dragSecId = secId; dragLinkIdx = linkIdx;\n            e.dataTransfer.effectAllowed = 'move';\n            const target = e.currentTarget;\n            setTimeout(() => target.classList.add('dragging'), 0);\n        }\n\n        function handleDragEnd(e) {\n            e.stopPropagation();\n            e.currentTarget.classList.remove('dragging');\n            document.querySelectorAll('.dynamic-section-card, .group').forEach(el => el.style.border = '');\n        }\n\n        function handleDragOver(e, type) {\n            e.preventDefault();\n            e.stopPropagation();\n            e.dataTransfer.dropEffect = 'move';\n            return false;\n        }\n\n        function handleDrop(e, type, targetSecId, targetLinkIdx = null) {\n            e.stopPropagation();\n            e.preventDefault();\n            if (localStorage.getItem('nav_admin_auth') !== 'true') return;\n\n            let secs = cloudConfig.dynamicSections || [];\n\n            if (dragType === 'section' && type === 'section') {\n                if (dragSecId === targetSecId) return;\n                const fromIdx = secs.findIndex(s => s.id === dragSecId);\n                const toIdx = secs.findIndex(s => s.id === targetSecId);\n                if(fromIdx > -1 && toIdx > -1) {\n                    const [moved] = secs.splice(fromIdx, 1);\n                    secs.splice(toIdx, 0, moved);\n                }\n            }\n            else if (dragType === 'link' && type === 'link') {\n                if (dragSecId === targetSecId && dragLinkIdx === targetLinkIdx) return;\n                const fromSec = secs.find(s => s.id === dragSecId);\n                const toSec = secs.find(s => s.id === targetSecId);\n                if (fromSec && toSec) {\n                    let actualTargetIdx = targetLinkIdx;\n                    const [movedLink] = fromSec.links.splice(dragLinkIdx, 1);\n                    toSec.links.splice(actualTargetIdx, 0, movedLink);\n                }\n            }\n            else if (dragType === 'link' && type === 'section') {\n                 const fromSec = secs.find(s => s.id === dragSecId);\n                 const toSec = secs.find(s => s.id === targetSecId);\n                 if (fromSec && toSec) {\n                     if (fromSec === toSec) return;\n                     const [movedLink] = fromSec.links.splice(dragLinkIdx, 1);\n                     toSec.links.push(movedLink);\n                 }\n            }\n            saveDynamicSections(secs);\n        }\n\n        // --- 3. 云端调度器 ---\n        async function initCloudData() {\n            const savedTheme = localStorage.getItem('nav_theme_mode') || 'theme-dark';\n            document.body.classList.remove('theme-light', 'theme-dark'); document.body.classList.add(savedTheme);\n            const globalDefaultBg = \"https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?q=80&w=2564&auto=format&fit=crop\";\n            let savedBg = localStorage.getItem('nav_custom_wallpaper');\n            cloudConfig.dynamicSections = JSON.parse(localStorage.getItem('nav_dynamic_sections') || '[]');\n\n            try {\n                const res = await fetch('/api/config');\n                if (res.ok) {\n                    const configData = await res.json();\n                    if (configData) {\n                        if (configData.wallpaper !== undefined) {\n                            if (configData.wallpaper === \"\") { savedBg = null; localStorage.removeItem('nav_custom_wallpaper'); document.body.classList.add('bg-cleared'); }\n                            else { savedBg = configData.wallpaper; localStorage.setItem('nav_custom_wallpaper', savedBg); document.body.classList.remove('bg-cleared'); }\n                        }\n                        if (configData.dynamicSections) { cloudConfig.dynamicSections = configData.dynamicSections; localStorage.setItem('nav_dynamic_sections', JSON.stringify(cloudConfig.dynamicSections)); }\n\n                    }\n                }\n            } catch (e) {}\n\n            if (!savedBg && !document.body.classList.contains('bg-cleared')) savedBg = globalDefaultBg;\n            if (savedBg) { applyWallpaperStyles(savedBg); document.getElementById('custom-bg-input').value = savedBg; document.getElementById('clear-bg-btn').classList.remove('hidden'); }\n            renderDynamicSections();\n        }\n\n        // 【核心】统一写云端方法：附带 X-Admin-Token 鉴权头\n        async function updateCloudConfig(key, value) {\n            cloudConfig[key] = value;\n            try {\n                await postCloudConfig();\n            } catch (e) {\n                console.error(\"云端配置同步失败\", e);\n            }\n        }\n\n        function toggleThemeMenu(e) { e.stopPropagation(); document.getElementById('theme-panel').classList.toggle('hidden'); }\n        function setBaseTheme(themeName) { document.body.classList.remove('theme-light', 'theme-dark'); document.body.classList.add(themeName); localStorage.setItem('nav_theme_mode', themeName); document.getElementById('theme-panel').classList.add('hidden'); }\n        function applyWallpaperStyles(url) { document.body.style.backgroundImage = `url('${url}')`; document.body.style.backgroundPosition = 'center'; document.body.style.backgroundSize = 'cover'; document.body.style.backgroundRepeat = 'no-repeat'; document.body.style.backgroundAttachment = 'fixed'; document.body.classList.add('has-custom-bg'); }\n\n        async function applyCustomBg() {\n            const url = document.getElementById('custom-bg-input').value.trim();\n            if (!url) return alert(t('validUrlMsg'));\n            applyWallpaperStyles(url); localStorage.setItem('nav_custom_wallpaper', url); document.body.classList.remove('bg-cleared'); document.getElementById('clear-bg-btn').classList.remove('hidden'); document.getElementById('theme-panel').classList.add('hidden');\n            updateCloudConfig('wallpaper', url);\n        }\n\n        async function clearCustomBg() {\n            document.body.style.backgroundImage = ''; document.body.classList.remove('has-custom-bg'); localStorage.removeItem('nav_custom_wallpaper'); document.body.classList.add('bg-cleared'); document.getElementById('custom-bg-input').value = ''; document.getElementById('clear-bg-btn').classList.add('hidden'); document.getElementById('theme-panel').classList.add('hidden');\n            updateCloudConfig('wallpaper', \"\");\n        }\n\n        // --- 4. 动态自定义区域管理 ---\n        function saveDynamicSections(sections) {\n            localStorage.setItem('nav_dynamic_sections', JSON.stringify(sections));\n            updateCloudConfig('dynamicSections', sections);\n            renderDynamicSections();\n        }\n\n        // 解析列数输入，返回合法整数\n        function parseColsInput(raw) {\n            const num = parseInt(raw, 10);\n            if (!Number.isFinite(num) || num < MIN_COLS || num > MAX_COLS) return null;\n            return num;\n        }\n\n        function addCustomSection() {\n            const title = prompt(t('promptSectionName'));\n            if (!title || title.trim() === '') return;\n\n            // 询问每行显示数量\n            const colsRaw = prompt(t('promptSectionCols'), String(DEFAULT_COLS));\n            if (colsRaw === null) return; // 用户取消\n            let cols = parseColsInput(colsRaw);\n            if (cols === null) {\n                alert(t('colsInvalidMsg'));\n                cols = DEFAULT_COLS;\n            }\n\n            let secs = cloudConfig.dynamicSections || [];\n            secs.push({ id: Date.now().toString(), title: title.trim(), cols: cols, links: [] });\n            saveDynamicSections(secs);\n        }\n\n        function renameCustomSection(id) {\n            let secs = cloudConfig.dynamicSections || [];\n            const sec = secs.find(s => s.id === id);\n            if(!sec) return;\n            const newTitle = prompt(t('renameSectionPrompt'), sec.title);\n            if(!newTitle || newTitle.trim() === '' || newTitle === sec.title) return;\n            sec.title = newTitle.trim();\n            saveDynamicSections(secs);\n        }\n\n        // 修改指定区域的每行列数\n        function changeSectionCols(id) {\n            let secs = cloudConfig.dynamicSections || [];\n            const sec = secs.find(s => s.id === id);\n            if(!sec) return;\n            const current = parseInt(sec.cols, 10) || DEFAULT_COLS;\n            const raw = prompt(t('promptSectionCols'), String(current));\n            if(raw === null) return;\n            let cols = parseColsInput(raw);\n            if (cols === null) { alert(t('colsInvalidMsg')); return; }\n            sec.cols = cols;\n            saveDynamicSections(secs);\n        }\n\n        function deleteCustomSection(id) {\n            if(!confirm(t('delSectionConfirm'))) return;\n            let secs = cloudConfig.dynamicSections || [];\n            secs = secs.filter(s => s.id !== id);\n            saveDynamicSections(secs);\n        }\n\n        function toggleDynamicSectionExpand(secId) {\n            expandedDynamicSections[secId] = !expandedDynamicSections[secId];\n            renderDynamicSections();\n        }\n\n        function renderDynamicSections() {\n            document.querySelectorAll('.dynamic-section-card').forEach(el => el.remove());\n            const grid = document.getElementById('main-nav-grid');\n            const addBtnCard = document.getElementById('add-section-card');\n            let secs = cloudConfig.dynamicSections || [];\n\n            secs.forEach((sec) => {\n                // 云端配置中的 ID 只接受安全字符，避免被拼接进内联事件属性。\n                if (!/^[a-zA-Z0-9_-]+$/.test(String(sec.id ?? ''))) return;\n                const isExpanded = !!expandedDynamicSections[sec.id];\n                const linkCount = sec.links.length;\n\n                // 读取每行列数配置，默认 2，限制 1-6\n                const cols = parseColsInput(sec.cols) || DEFAULT_COLS;\n                // 列数较多或链接较多时，自动进入紧凑样式\n                const isCompact = linkCount > 6 || cols >= 3;\n\n                let visibleLinks = sec.links;\n                let showExpandBtn = false;\n\n                if (linkCount > 9) {\n                    showExpandBtn = true;\n                    if (!isExpanded) {\n                        visibleLinks = sec.links.slice(0, 9);\n                    }\n                }\n\n                const card = document.createElement('div');\n                // 每个区域独占一整行（单列网格）\n                card.className = \"dynamic-section-card glass-card rounded-2xl p-6 shadow-xl hover:border-indigo-500/30 transition-all duration-300 relative\";\n                card.id = `section-${sec.id}`;\n                card.draggable = true;\n                card.ondragstart = (e) => handleDragStart(e, 'section', sec.id);\n                card.ondragend = handleDragEnd;\n                card.ondragover = (e) => handleDragOver(e, 'section');\n                card.ondrop = (e) => handleDrop(e, 'section', sec.id);\n\n                let linksHtml = '';\n                if (linkCount === 0) {\n                    linksHtml = `<div class=\"text-center text-xs text-slate-400/60 py-4\" style=\"grid-column: 1 / -1;\">${t('noCloudLinks')}</div>`;\n                } else {\n                    const pClass = isCompact ? 'p-2' : 'p-3';\n                    const spaceXClass = isCompact ? 'space-x-1.5' : 'space-x-2.5';\n                    const iconSizeClass = isCompact ? 'w-4 h-4 text-[9px]' : 'w-5 h-5 text-[10px]';\n                    const textSizeClass = isCompact ? 'text-[11px]' : 'text-sm';\n                    const prClass = isCompact ? 'pr-4' : 'pr-5';\n                    const dragMrClass = isCompact ? 'mr-1.5' : 'mr-2.5';\n                    const btnClass = isCompact ? 'right-1 text-[10px] px-1 py-0.5' : 'right-2 text-xs p-1';\n\n                    visibleLinks.forEach((link, idx) => {\n                        const displayName = escapeHtml(link.name);\n                        let displayIcon = `<div class=\"${iconSizeClass} rounded-full bg-indigo-500/20 text-indigo-400 flex items-center justify-center font-bold shrink-0\">${escapeHtml(displayName.charAt(0).toUpperCase())}</div>`;\n\n                        linksHtml += `\n                        <div class=\"group relative flex items-center justify-between ${pClass} bg-slate-500/5 border border-slate-500/10 rounded-xl hover:bg-indigo-600/10 transition-all\"\n                             draggable=\"true\"\n                             ondragstart=\"handleDragStart(event, 'link', '${sec.id}', ${idx})\"\n                             ondragend=\"handleDragEnd(event)\"\n                             ondragover=\"handleDragOver(event, 'link')\"\n                             ondrop=\"handleDrop(event, 'link', '${sec.id}', ${idx})\">\n                            <div class=\"flex items-center w-full overflow-hidden\">\n                                <i class=\"fas fa-grip-vertical text-slate-500 opacity-0 group-hover:opacity-50 transition-opacity ${dragMrClass} cursor-move admin-only text-[10px] shrink-0\"></i>\n                                <a href=\"${escapeHtml(safeHttpUrl(link.url))}\" draggable=\"false\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"flex items-center ${spaceXClass} truncate w-full ${prClass}\">\n                                    ${displayIcon} <span class=\"${textSizeClass} font-medium truncate\">${displayName}</span>\n                                </a>\n                            </div>\n                            <button type=\"button\" onclick=\"deleteSectionLink(event, '${sec.id}', ${idx})\" class=\"admin-only absolute ${btnClass} text-slate-400 hover:text-red-400 opacity-0 group-hover:opacity-100 transition-opacity bg-slate-500/20 rounded cursor-pointer shrink-0\"><i class=\"fas fa-trash-alt\"></i></button>\n                        </div>`;\n                    });\n                }\n\n                let expandHtml = '';\n                if (showExpandBtn) {\n                    const btnText = isExpanded\n                        ? `<span data-i18n=\"collapseMore\">${t('collapseMore')}</span> <i class=\"fas fa-chevron-up text-[10px]\"></i>`\n                        : `<span data-i18n=\"expandMore\">${t('expandMore')}</span> (${linkCount - 9}) <i class=\"fas fa-chevron-down text-[10px]\"></i>`;\n                    expandHtml = `\n                        <div class=\"mt-4 pt-2 border-t border-slate-500/10 text-center\">\n                            <button type=\"button\" onclick=\"toggleDynamicSectionExpand('${sec.id}')\" class=\"text-xs font-semibold text-indigo-400 hover:text-indigo-300 transition-colors cursor-pointer inline-flex items-center gap-1\">\n                                ${btnText}\n                            </button>\n                        </div>\n                    `;\n                }\n\n                const gapClass = isCompact ? 'gap-2' : 'gap-3';\n\n                card.innerHTML = `\n                    <div class=\"flex justify-between items-center mb-4\">\n                        <h3 class=\"text-lg font-semibold text-indigo-400 flex items-center cursor-move\" title=\"长按拖拽排序\" style=\"cursor: grab;\">\n                            <i class=\"fas fa-grip-vertical mr-2 text-slate-500 opacity-60 admin-only text-sm\"></i>\n                            <i class=\"fas fa-layer-group mr-2.5\"></i> <span>${escapeHtml(sec.title)}</span>\n                        </h3>\n                        <div class=\"flex gap-1.5 shrink-0 ml-2\">\n                            <button type=\"button\" onclick=\"openLinkModal('section_${sec.id}')\" class=\"admin-only text-[10px] px-2 py-1 bg-indigo-600/20 text-indigo-400 border border-indigo-500/20 rounded-md hover:bg-indigo-600/40 transition-colors cursor-pointer z-[50]\">${t('addCloud')}</button>\n                            <button type=\"button\" onclick=\"changeSectionCols('${sec.id}')\" title=\"${t('changeColsTitle')}\" class=\"admin-only text-[10px] px-2 py-1 bg-purple-600/20 text-purple-400 border border-purple-500/20 rounded-md hover:bg-purple-600/40 transition-colors cursor-pointer z-[50]\"><i class=\"fas fa-table-columns\"></i></button>\n                            <button type=\"button\" onclick=\"renameCustomSection('${sec.id}')\" class=\"admin-only text-[10px] px-2 py-1 bg-sky-600/20 text-sky-400 border border-sky-500/20 rounded-md hover:bg-sky-600/40 transition-colors cursor-pointer z-[50]\"><i class=\"fas fa-pen\"></i></button>\n                            <button type=\"button\" onclick=\"deleteCustomSection('${sec.id}')\" class=\"admin-only text-[10px] px-2 py-1 bg-red-600/20 text-red-400 border border-red-500/20 rounded-md hover:bg-red-600/40 transition-colors cursor-pointer z-[50]\"><i class=\"fas fa-trash\"></i></button>\n                        </div>\n                    </div>\n                    <div class=\"grid ${gapClass}\" style=\"grid-template-columns: repeat(${cols}, minmax(0, 1fr)); min-height: 40px;\" ondragover=\"handleDragOver(event, 'section')\" ondrop=\"handleDrop(event, 'section', '${sec.id}')\">\n                        ${linksHtml}\n                    </div>\n                    ${expandHtml}\n                `;\n                grid.insertBefore(card, addBtnCard);\n            });\n            checkAdminSession();\n        }\n\n        function deleteSectionLink(e, secId, linkIdx) {\n            e.preventDefault(); e.stopPropagation();\n            let secs = cloudConfig.dynamicSections || [];\n            const sec = secs.find(s => s.id === secId);\n            if(sec) { sec.links.splice(linkIdx, 1); saveDynamicSections(secs); }\n        }\n\n        // --- 5. 智能时间预测系统 ---\n        const sTermNames = [\"小寒\", \"大寒\", \"立春\", \"雨水\", \"惊蛰\", \"春分\", \"清明\", \"谷雨\", \"立夏\", \"小满\", \"芒种\", \"夏至\", \"小暑\", \"大暑\", \"立秋\", \"处暑\", \"白露\", \"秋分\", \"寒露\", \"霜降\", \"立冬\", \"小雪\", \"大雪\", \"冬至\"];\n        const sTermInfo = [0, 21208, 42467, 63836, 85337, 107014, 128867, 150921, 173149, 195551, 218072, 240693, 263343, 285989, 308563, 331033, 353350, 375494, 397447, 419210, 440795, 462224, 483532, 504758];\n        function getSolarTerm(y, m, d) { const baseDate = new Date(1900, 0, 6, 2, 5, 0); const termDate = new Date((31556925974.7 * (y - 1900) + sTermInfo[(m * 2)]) + baseDate.getTime()); if (termDate.getMonth() == m && termDate.getDate() == d) return sTermNames[m * 2]; const termDate2 = new Date((31556925974.7 * (y - 1900) + sTermInfo[(m * 2 + 1)]) + baseDate.getTime()); if (termDate2.getMonth() == m && termDate2.getDate() == d) return sTermNames[m * 2 + 1]; return null; }\n        function updateClockAndGreeting() {\n            const now = new Date(); const y = now.getFullYear(), m = now.getMonth(), d = now.getDate(), h = now.getHours();\n            document.getElementById('clock').innerText = `${String(h).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}:${String(now.getSeconds()).padStart(2, '0')}`;\n            let greetStr = \"\";\n            if (currentLang === 'zh') {\n                const term = getSolarTerm(y, m, d); const md = `${String(m+1).padStart(2, '0')}${String(d).padStart(2, '0')}`;\n                const fests = { \"0101\": \"元旦快乐\", \"0308\": \"妇女节快乐\", \"0501\": \"五一劳动节\", \"0601\": \"儿童节快乐\", \"1001\": \"国庆节快乐\", \"1225\": \"圣诞节\" }; const fest = fests[md] || null;\n                if (fest) greetStr = `🎉 今天是 ${fest}，祝你开心！`; else if (term) greetStr = `🍃 今日节气 · 【${term}】，顺应四时，平安喜乐。`;\n                else { if (h >= 0 && h < 5) greetStr = \"🌙 夜深了，静谧的星空在守护你，早点休息哦\"; else if (h >= 5 && h < 8) greetStr = \"🌅 清晨的朝阳刚刚升起，新的一天充满希望\"; else if (h >= 8 && h < 11.5) greetStr = \"☀️ 早上好，专注当下，今天也要元气满满\"; else if (h >= 11.5 && h < 13.5) greetStr = \"🍲 中午好，记得按时吃饭，歇息一下双眼\"; else if (h >= 13.5 && h < 17.5) greetStr = \"☕ 下午好，来杯清茶或咖啡，继续保持高效\"; else if (h >= 17.5 && h < 19.5) greetStr = \"🌇 傍晚好，落日余晖很美，放下疲惫准备享受夜晚吧\"; else greetStr = \"✨ 晚上好，属于自己的惬意时光，好好犒劳一下自己\"; }\n            } else {\n                if (h >= 0 && h < 5) greetStr = \"🌙 Late night, the stars are watching over you. Sleep early.\"; else if (h >= 5 && h < 8) greetStr = \"🌅 The morning sun is rising, a new day full of hope.\"; else if (h >= 8 && h < 11.5) greetStr = \"☀️ Good morning! Stay focused and full of energy.\"; else if (h >= 11.5 && h < 13.5) greetStr = \"🍲 Good noon! Remember to eat on time and rest your eyes.\"; else if (h >= 13.5 && h < 17.5) greetStr = \"☕ Good afternoon! Grab a tea or coffee and keep it up.\"; else if (h >= 17.5 && h < 19.5) greetStr = \"🌇 Good evening! The sunset is beautiful. Relax and enjoy.\"; else greetStr = \"✨ Good night! Enjoy your cozy time and treat yourself well.\";\n            }\n            document.getElementById('greeting').innerText = greetStr;\n        }\n        setInterval(updateClockAndGreeting, 1000);\n\n        // --- 6. 搜索引擎配置 ---\n        const engines = { google: { action: 'https://www.google.com/search', name: 'q', placeholderKey: 'searchGoogle', icon: 'fab fa-google text-blue-400' }, bing: { action: 'https://cn.bing.com/search', name: 'q', placeholderKey: 'searchBing', icon: 'fab fa-microsoft text-teal-400' }, baidu: { action: 'https://www.baidu.com/s', name: 'wd', placeholderKey: 'searchBaidu', icon: 'fas fa-paw text-red-400' }, github: { action: 'https://github.com/search', name: 'q', placeholderKey: 'searchGithub', icon: 'fab fa-github text-slate-400' } };\n        function toggleEngineMenu(e) { e.stopPropagation(); document.getElementById('engine-menu').classList.toggle('hidden'); }\n        function selectEngine(key) { currentEngineKey = key; const form = document.getElementById('search-form'); const input = document.getElementById('search-input'); const icon = document.getElementById('engine-icon'); form.action = engines[key].action; input.name = engines[key].name; input.setAttribute('data-i18n-placeholder', engines[key].placeholderKey); input.placeholder = t(engines[key].placeholderKey); icon.className = engines[key].icon; document.getElementById('engine-menu').classList.add('hidden'); }\n\n        // --- 7. 动态区域链接管理 ---\n        function openLinkModal(target) {\n            currentModalTarget = target;\n            document.getElementById('modal-title-text').innerText = t('modalAddSection');\n            toggleModal(true);\n        }\n        function toggleModal(show) { const modal = document.getElementById('modal'); if (show) { document.getElementById('site-name').value = ''; document.getElementById('site-url').value = ''; modal.classList.remove('hidden'); } else { modal.classList.add('hidden'); } }\n        function closeModalOnBlank(e) { if(e.target.id === 'modal') toggleModal(false); }\n\n        async function saveActiveLink() {\n            const name = document.getElementById('site-name').value.trim();\n            let url = document.getElementById('site-url').value.trim();\n            if (!name || !url) return alert(currentLang === 'zh' ? '请完整填写名称和网址！' : 'Please fill in both name and URL!');\n            if (!/^https?:\\/\\//i.test(url)) url = 'https://' + url;\n            try {\n                const parsedUrl = new URL(url);\n                if (!['http:', 'https:'].includes(parsedUrl.protocol)) throw new Error();\n                url = parsedUrl.href;\n            } catch (_) {\n                return alert(t('validUrlMsg'));\n            }\n\n            const secId = currentModalTarget.replace('section_', '');\n            const secs = cloudConfig.dynamicSections || [];\n            const sec = secs.find(s => s.id === secId);\n            if (sec) {\n                sec.links.push({ name, url });\n                saveDynamicSections(secs);\n            }\n            toggleModal